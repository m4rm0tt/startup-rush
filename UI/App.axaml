<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:px="using:UI.Pixel"
             x:Class="UI.App"
             RequestedThemeVariant="Light">
    <!-- Direction artistique : HUD « Papier » du pack original (crème et encre, accents sarcelle, corail et soleil),
         polices originales StartupRush Pixel et Mono, cadres 9-slice du pack, aucun arrondi -->

    <Application.Resources>
        <FontFamily x:Key="PixelFont">avares://UI/Assets/Fonts#StartupRush Pixel</FontFamily>
        <FontFamily x:Key="TermFont">avares://UI/Assets/Fonts#StartupRush Mono</FontFamily>
        <FontFamily x:Key="TitleFont">avares://UI/Assets/Fonts#StartupRush Pixel</FontFamily>

        <!-- Jetons du thème « Papier » (assets/hud/theme_tokens.json) ; les noms sont ceux de UI/Pixel/Palette.cs -->
        <SolidColorBrush x:Key="Ink" Color="#2b2128"/>
        <SolidColorBrush x:Key="Night" Color="#efe4cc"/>
        <SolidColorBrush x:Key="Slate" Color="#dccdb1"/>
        <SolidColorBrush x:Key="Steel" Color="#c2ae94"/>
        <SolidColorBrush x:Key="Fog" Color="#6f5f5d"/>
        <SolidColorBrush x:Key="Cloud" Color="#4a3a42"/>
        <SolidColorBrush x:Key="Snow" Color="#2b2128"/>
        <SolidColorBrush x:Key="Gold" Color="#c9922e"/>
        <SolidColorBrush x:Key="Lemon" Color="#275a66"/>
        <SolidColorBrush x:Key="Leaf" Color="#437d40"/>
        <SolidColorBrush x:Key="Forest" Color="#437d40"/>
        <SolidColorBrush x:Key="Blood" Color="#a23a34"/>
        <SolidColorBrush x:Key="Wine" Color="#74292b"/>
        <SolidColorBrush x:Key="Sky" Color="#4670a6"/>
        <SolidColorBrush x:Key="Ice" Color="#357c82"/>
        <SolidColorBrush x:Key="Plum" Color="#8f3d39"/>
        <SolidColorBrush x:Key="Ember" Color="#c05843"/>
        <SolidColorBrush x:Key="Paper" Color="#fbf5e6"/>
        <SolidColorBrush x:Key="OnAccent" Color="#fbf5e6"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Textes -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Titres : StartupRush Pixel, comme le reste de l'interface -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.h1.title">
            <Setter Property="FontSize" Value="44"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
        </Style>

        <!-- Panneaux : cadre 9-slice (voir PixelPanel) -->
        <Style Selector="px|PixelPanel.panel">
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="px|PixelPanel.inset">
            <Setter Property="Skin" Value="inset"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="Padding" Value="6,1"/>
        </Style>

        <!-- Cartes qui se soulèvent au survol -->
        <Style Selector="px|PixelPanel.lift">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="px|PixelPanel.lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-10px) scale(1.04)"/>
        </Style>

        <!-- Boutons : cadre 9-slice qui change avec l'état. Pas de focus clavier : Espace sert à travailler -->
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="Padding" Value="14,6,14,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <px:PixelPanel x:Name="PART_Frame" Skin="button" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </px:PixelPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_hover"/>
        </Style>
        <Style Selector="Button:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_pressed"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translateY(2px)"/>
        </Style>

        <Style Selector="Button.gold">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.gold /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold"/>
        </Style>
        <Style Selector="Button.gold:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold_hover"/>
        </Style>
        <Style Selector="Button.gold:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold_pressed"/>
        </Style>
        <Style Selector="Button.green /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green_hover"/>
        </Style>
        <Style Selector="Button.green:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green_pressed"/>
        </Style>
        <Style Selector="Button.red /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red"/>
        </Style>
        <Style Selector="Button.red:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red_hover"/>
        </Style>
        <Style Selector="Button.red:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red_pressed"/>
        </Style>
        <Style Selector="Button.big">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="24,10,24,14"/>
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.green">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.red">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.tab.selected /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold"/>
        </Style>

        <!-- Désactivé : en dernier pour passer devant les couleurs -->
        <Style Selector="Button:disabled /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_disabled"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
        </Style>

        <!-- Bouton qui n'est qu'une zone cliquable (cartes) -->
        <Style Selector="Button.plain /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="none"/>
        </Style>

        <!-- Barres -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="MinHeight" Value="4"/>
        </Style>
        <Style Selector="ProgressBar /template/ Border">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- Saisie, infobulles -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Steel}"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

    </Application.Styles>
</Application>
