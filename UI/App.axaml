<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:px="using:UI.Pixel"
             x:Class="UI.App"
             RequestedThemeVariant="Light">
    <!-- Direction artistique : HUD « Papier » du pack original (crème et encre, accents sarcelle, corail et soleil),
         polices originales StartupRush Pixel et Mono, cadres 9-slice du pack, aucun arrondi -->

    <Application.Resources>
        <FontFamily x:Key="PixelFont">avares://UI/Assets/Fonts#StartupRush Pixel</FontFamily>
        <FontFamily x:Key="TermFont">avares://UI/Assets/Fonts#StartupRush Mono</FontFamily>
        <FontFamily x:Key="TitleFont">avares://UI/Assets/Fonts#StartupRush Pixel</FontFamily>

        <!-- Jetons du thème « Papier » (assets/hud/theme_tokens.json) ; les noms sont ceux de UI/Pixel/Palette.cs -->
        <SolidColorBrush x:Key="Ink" Color="#2b2128"/>
        <SolidColorBrush x:Key="Night" Color="#efe4cc"/>
        <SolidColorBrush x:Key="Slate" Color="#dccdb1"/>
        <SolidColorBrush x:Key="Steel" Color="#c2ae94"/>
        <SolidColorBrush x:Key="Fog" Color="#6f5f5d"/>
        <SolidColorBrush x:Key="Cloud" Color="#4a3a42"/>
        <SolidColorBrush x:Key="Snow" Color="#2b2128"/>
        <SolidColorBrush x:Key="Gold" Color="#c9922e"/>
        <SolidColorBrush x:Key="Lemon" Color="#275a66"/>
        <SolidColorBrush x:Key="Leaf" Color="#437d40"/>
        <SolidColorBrush x:Key="Forest" Color="#437d40"/>
        <SolidColorBrush x:Key="Blood" Color="#a23a34"/>
        <SolidColorBrush x:Key="Wine" Color="#74292b"/>
        <SolidColorBrush x:Key="Sky" Color="#4670a6"/>
        <SolidColorBrush x:Key="Ice" Color="#357c82"/>
        <SolidColorBrush x:Key="Plum" Color="#8f3d39"/>
        <SolidColorBrush x:Key="Ember" Color="#c05843"/>
        <SolidColorBrush x:Key="Paper" Color="#fbf5e6"/>
        <SolidColorBrush x:Key="OnAccent" Color="#fbf5e6"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Textes -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Titres : StartupRush Pixel, comme le reste de l'interface -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.h1.title">
            <Setter Property="FontSize" Value="44"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
        </Style>

        <!-- Panneaux : cadre 9-slice (voir PixelPanel) -->
        <Style Selector="px|PixelPanel.panel">
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="px|PixelPanel.inset">
            <Setter Property="Skin" Value="inset"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="Padding" Value="6,1"/>
        </Style>

        <!-- Cartes qui se soulèvent au survol -->
        <Style Selector="px|PixelPanel.lift">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="px|PixelPanel.lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-10px) scale(1.04)"/>
        </Style>

        <!-- Boutons : cadre 9-slice qui change avec l'état. Pas de focus clavier : Espace sert à travailler -->
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="Padding" Value="14,6,14,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <px:PixelPanel x:Name="PART_Frame" Skin="button" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </px:PixelPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_hover"/>
        </Style>
        <Style Selector="Button:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_pressed"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translateY(2px)"/>
        </Style>

        <Style Selector="Button.gold">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.gold /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold"/>
        </Style>
        <Style Selector="Button.gold:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold_hover"/>
        </Style>
        <Style Selector="Button.gold:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold_pressed"/>
        </Style>
        <Style Selector="Button.green /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green_hover"/>
        </Style>
        <Style Selector="Button.green:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="green_pressed"/>
        </Style>
        <Style Selector="Button.red /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red"/>
        </Style>
        <Style Selector="Button.red:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red_hover"/>
        </Style>
        <Style Selector="Button.red:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="red_pressed"/>
        </Style>
        <Style Selector="Button.big">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="24,10,24,14"/>
        </Style>
        <!-- « tab » : bouton secondaire du jeu (−/+, Voir, Fiche) → bouton texte du pack ; « tab selected » : bascule allumée -->
        <Style Selector="Button.tab">
            <Setter Property="Foreground" Value="{StaticResource Lemon}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="Button.tab /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="pack:hud_button_text:normal"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="pack:hud_button_text:hover"/>
        </Style>
        <Style Selector="Button.tab:pressed /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="pack:hud_button_text:pressed"/>
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>

        <!-- Choix exclusifs (Ui.Choice) : contrôle segmenté du pack, le choisi en sarcelle -->
        <Style Selector="Button.seg">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Button.seg.selected">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.seg /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_mid:normal"/></Style>
        <Style Selector="Button.seg:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_mid:hover"/></Style>
        <Style Selector="Button.seg.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_mid:selected"/></Style>
        <Style Selector="Button.seg.first /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_left:normal"/></Style>
        <Style Selector="Button.seg.first:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_left:hover"/></Style>
        <Style Selector="Button.seg.first.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_left:selected"/></Style>
        <Style Selector="Button.seg.last /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_right:normal"/></Style>
        <Style Selector="Button.seg.last:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_right:hover"/></Style>
        <Style Selector="Button.seg.last.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_right:selected"/></Style>
        <Style Selector="Button.seg:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="RenderTransform" Value="none"/></Style>

        <!-- Vrais onglets (navigation, onglets d'une fiche) : l'actif déborde sur le panneau -->
        <Style Selector="Button.tabs">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="Button.tabs.selected">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style Selector="Button.tabs /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_tabs:inactive"/></Style>
        <Style Selector="Button.tabs:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_tabs:hover"/></Style>
        <Style Selector="Button.tabs.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_tabs:active"/></Style>

        <!-- Rangées de liste cliquables (journal) -->
        <Style Selector="Button.row">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.row /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_list_row:normal"/></Style>
        <Style Selector="Button.row:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_list_row:hover"/></Style>
        <Style Selector="Button.row.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_list_row:selected"/></Style>
        <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="RenderTransform" Value="none"/></Style>

        <!-- Boutons à icône (pause, vitesses, fermer, retour) -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="6,4,6,7"/>
        </Style>
        <Style Selector="Button.icon /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon:normal"/></Style>
        <Style Selector="Button.icon:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon:hover"/></Style>
        <Style Selector="Button.icon:pressed /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon:pressed"/></Style>
        <Style Selector="Button.icon.selected /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon:toggled"/></Style>
        <!-- Petits boutons à icône des barres de titre -->
        <Style Selector="Button.icon.small">
            <Setter Property="Padding" Value="6,5,6,7"/>
        </Style>
        <Style Selector="Button.icon.small /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon_small:normal"/></Style>
        <Style Selector="Button.icon.small:pointerover /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon_small:hover"/></Style>
        <Style Selector="Button.icon.small:pressed /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon_small:pressed"/></Style>
        <Style Selector="Button.green">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.red">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        </Style>
        <Style Selector="Button.tab.selected /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="gold"/>
        </Style>

        <!-- Désactivé : en dernier pour passer devant les couleurs -->
        <Style Selector="Button:disabled /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="button_disabled"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
        </Style>
        <Style Selector="Button.tab:disabled /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_text:disabled"/></Style>
        <Style Selector="Button.seg:disabled /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_mid:disabled"/></Style>
        <Style Selector="Button.seg.first:disabled /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_left:disabled"/></Style>
        <Style Selector="Button.seg.last:disabled /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_segmented_right:disabled"/></Style>
        <Style Selector="Button.icon:disabled /template/ px|PixelPanel#PART_Frame"><Setter Property="Skin" Value="pack:hud_button_icon:disabled"/></Style>

        <!-- Bouton qui n'est qu'une zone cliquable (cartes) -->
        <Style Selector="Button.plain /template/ px|PixelPanel#PART_Frame">
            <Setter Property="Skin" Value="none"/>
        </Style>

        <!-- Barres -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="MinHeight" Value="4"/>
        </Style>
        <Style Selector="ProgressBar /template/ Border">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- Saisie, infobulles -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Steel}"/>
        </Style>
        <!-- Infobulle : cadre sombre du pack (hud_tooltip), texte clair -->
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="MaxWidth" Value="340"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <px:PixelPanel Skin="pack:hud_tooltip" Padding="10,6,10,9">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </px:PixelPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
        </Style>

        <!-- Glissière : le contrôle ne porte que le bouton du pack ; piste et remplissage sont dessinés dessous par Ui.Slider -->
        <Style Selector="Slider:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Height="28" Background="Transparent">
                        <Track Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Classes="slider"/></Track.DecreaseButton>
                            <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Classes="slider"/></Track.IncreaseButton>
                            <Thumb Classes="knob" Width="20" Height="28"/>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider RepeatButton.slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter>
        </Style>
        <Style Selector="Slider Thumb.knob">
            <Setter Property="Template"><ControlTemplate><px:PixelPanel Skin="{TemplateBinding Tag}"/></ControlTemplate></Setter>
            <Setter Property="Tag" Value="pack:hud_slider_knob:normal"/>
        </Style>
        <Style Selector="Slider Thumb.knob:pointerover"><Setter Property="Tag" Value="pack:hud_slider_knob:hover"/></Style>
        <Style Selector="Slider Thumb.knob:pressed"><Setter Property="Tag" Value="pack:hud_slider_knob:pressed"/></Style>
        <Style Selector="Slider:disabled Thumb.knob"><Setter Property="Tag" Value="pack:hud_slider_knob:disabled"/></Style>

        <!-- Barres de défilement du pack : piste, curseur avec sa poignée, flèches -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="20,*,20">
                        <RepeatButton Name="PART_LineUpButton" Classes="arrow up" Grid.Row="0"/>
                        <px:PixelPanel Grid.Row="1" Skin="pack:hud_scroll_track_v"/>
                        <Track Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Classes="page"/></Track.DecreaseButton>
                            <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Classes="page"/></Track.IncreaseButton>
                            <Thumb Classes="v"/>
                        </Track>
                        <RepeatButton Name="PART_LineDownButton" Classes="arrow down" Grid.Row="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="20,*,20">
                        <RepeatButton Name="PART_LineUpButton" Classes="arrow left" Grid.Column="0"/>
                        <px:PixelPanel Grid.Column="1" Skin="pack:hud_scroll_track_h"/>
                        <Track Name="PART_Track" Grid.Column="1" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Classes="page"/></Track.DecreaseButton>
                            <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Classes="page"/></Track.IncreaseButton>
                            <Thumb Classes="h"/>
                        </Track>
                        <RepeatButton Name="PART_LineDownButton" Classes="arrow right" Grid.Column="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar RepeatButton.page">
            <Setter Property="Template"><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter>
        </Style>
        <Style Selector="ScrollBar RepeatButton.arrow">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate><px:PixelPanel Name="PART_Frame" Skin="{TemplateBinding Tag}"/></ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar RepeatButton.arrow.up"><Setter Property="Tag" Value="pack:hud_scroll_arrow_up:normal"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.up:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_arrow_up:hover"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.up:pressed"><Setter Property="Tag" Value="pack:hud_scroll_arrow_up:pressed"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.up:disabled"><Setter Property="Tag" Value="pack:hud_scroll_arrow_up:disabled"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.down"><Setter Property="Tag" Value="pack:hud_scroll_arrow_down:normal"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.down:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_arrow_down:hover"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.down:pressed"><Setter Property="Tag" Value="pack:hud_scroll_arrow_down:pressed"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.down:disabled"><Setter Property="Tag" Value="pack:hud_scroll_arrow_down:disabled"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.left"><Setter Property="Tag" Value="pack:hud_scroll_arrow_left:normal"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.left:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_arrow_left:hover"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.left:pressed"><Setter Property="Tag" Value="pack:hud_scroll_arrow_left:pressed"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.left:disabled"><Setter Property="Tag" Value="pack:hud_scroll_arrow_left:disabled"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.right"><Setter Property="Tag" Value="pack:hud_scroll_arrow_right:normal"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.right:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_arrow_right:hover"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.right:pressed"><Setter Property="Tag" Value="pack:hud_scroll_arrow_right:pressed"/></Style>
        <Style Selector="ScrollBar RepeatButton.arrow.right:disabled"><Setter Property="Tag" Value="pack:hud_scroll_arrow_right:disabled"/></Style>
        <!-- Curseur : cadre étiré et poignée centrée, jamais étirée -->
        <Style Selector="ScrollBar Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <px:PixelPanel Skin="{TemplateBinding Tag}"/>
                        <Image Name="Grip" Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="None"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar Thumb.v"><Setter Property="Tag" Value="pack:hud_scroll_thumb_v:normal"/></Style>
        <Style Selector="ScrollBar Thumb.v:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_thumb_v:hover"/></Style>
        <Style Selector="ScrollBar Thumb.v:pressed"><Setter Property="Tag" Value="pack:hud_scroll_thumb_v:pressed"/></Style>
        <Style Selector="ScrollBar Thumb.h"><Setter Property="Tag" Value="pack:hud_scroll_thumb_h:normal"/></Style>
        <Style Selector="ScrollBar Thumb.h:pointerover"><Setter Property="Tag" Value="pack:hud_scroll_thumb_h:hover"/></Style>
        <Style Selector="ScrollBar Thumb.h:pressed"><Setter Property="Tag" Value="pack:hud_scroll_thumb_h:pressed"/></Style>
        <Style Selector="ScrollBar Thumb.v /template/ Image#Grip">
            <Setter Property="Source" Value="{x:Static px:PackSkins.GripV}"/>
        </Style>
        <Style Selector="ScrollBar Thumb.h /template/ Image#Grip">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Source" Value="{x:Static px:PackSkins.GripH}"/>
        </Style>

    </Application.Styles>
</Application>
