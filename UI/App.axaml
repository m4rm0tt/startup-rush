<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UI.App"
             RequestedThemeVariant="Dark">
    <!-- Direction artistique : palette Endesga 32, polices pixel (SIL OFL), aucun arrondi, ombres dures -->

    <Application.Resources>
        <FontFamily x:Key="PixelFont">avares://UI/Assets/Fonts#Pixelify Sans</FontFamily>
        <FontFamily x:Key="TermFont">avares://UI/Assets/Fonts#VT323</FontFamily>

        <SolidColorBrush x:Key="Ink" Color="#181425"/>
        <SolidColorBrush x:Key="Night" Color="#262b44"/>
        <SolidColorBrush x:Key="Slate" Color="#3a4466"/>
        <SolidColorBrush x:Key="Steel" Color="#5a6988"/>
        <SolidColorBrush x:Key="Fog" Color="#8b9bb4"/>
        <SolidColorBrush x:Key="Cloud" Color="#c0cbdc"/>
        <SolidColorBrush x:Key="Snow" Color="#ffffff"/>
        <SolidColorBrush x:Key="Gold" Color="#feae34"/>
        <SolidColorBrush x:Key="Lemon" Color="#fee761"/>
        <SolidColorBrush x:Key="Leaf" Color="#63c74d"/>
        <SolidColorBrush x:Key="Forest" Color="#3e8948"/>
        <SolidColorBrush x:Key="Blood" Color="#e43b44"/>
        <SolidColorBrush x:Key="Wine" Color="#a22633"/>
        <SolidColorBrush x:Key="Sky" Color="#0099db"/>
        <SolidColorBrush x:Key="Ice" Color="#2ce8f5"/>
        <SolidColorBrush x:Key="Plum" Color="#b55088"/>
        <SolidColorBrush x:Key="Ember" Color="#f77622"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Textes -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
        </Style>

        <!-- Panneaux : cadre clair, contour sombre et ombre dure décalée -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource Night}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Steel}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BoxShadow" Value="0 0 0 2 #181425, 6 6 0 2 #0b0913"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="Padding" Value="6,1"/>
        </Style>

        <!-- Cartes qui se soulèvent au survol -->
        <Style Selector="Border.lift">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-10px) scale(1.04)"/>
        </Style>

        <!-- Boutons pixel -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Steel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Snow}"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Night}"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Night}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource Steel}"/>
        </Style>

        <Style Selector="Button.gold">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.gold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Lemon}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style Selector="Button.green">
            <Setter Property="Background" Value="{StaticResource Forest}"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Leaf}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style Selector="Button.red">
            <Setter Property="Background" Value="{StaticResource Wine}"/>
        </Style>
        <Style Selector="Button.red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Blood}"/>
        </Style>
        <Style Selector="Button.big">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="24,10"/>
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="{StaticResource Night}"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <!-- Barres -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="MinHeight" Value="4"/>
        </Style>
        <Style Selector="ProgressBar /template/ Border">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- Saisie, infobulles -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Steel}"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

    </Application.Styles>
</Application>
