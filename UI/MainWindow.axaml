<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="UI.MainWindow"
        Title="Startup Rush"
        Width="1440" Height="810" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#181425"
        FontFamily="{StaticResource PixelFont}"
        RenderOptions.TextRenderingMode="Alias">
    <!-- La scène occupe toute la fenêtre à sa taille réelle ; seuls les menus sont mis à l'échelle (réglage « Taille de l'interface ») -->
    <Grid x:Name="Root" ClipToBounds="True">
        <ContentControl x:Name="ScreenHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Rectangle x:Name="FadeLayer" Fill="#000000" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
