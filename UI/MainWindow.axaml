<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="UI.MainWindow"
        Title="Startup Rush"
        Width="1360" Height="820" MinWidth="1200" MinHeight="740"
        Background="#1C2529">
        <!-- L'écran affiché suit l'état courant de la machine à états -->
        <ContentControl x:Name="ScreenHost"/>
</Window>
