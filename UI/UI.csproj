<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Sons et musiques tirés des packs de assets/ par tools/build_assets.py (voir ASSET_USAGE.md) ; les images viennent du pack original, plus bas -->
        <AvaloniaResource Include="Assets\Audio\**\*.wav;Assets\Audio\**\*.ogg" />
        <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pack original (assets/StartupRushOriginalAssets) : sprites, masques, manifeste et plans, embarqués dans l'exécutable.
             Lus par UI/Iso/PackLibrary.cs ; aucun chemin de développement dans le jeu livré. -->
        <EmbeddedResource Include="..\assets\StartupRushOriginalAssets\manifest.json" LogicalName="pack/manifest.json" />
        <EmbeddedResource Include="..\assets\StartupRushOriginalAssets\rooms\*.json" LogicalName="pack/rooms/%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\assets\StartupRushOriginalAssets\assets\**\*.png" LogicalName="pack/assets/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\assets\StartupRushOriginalAssets\masks\**\*.png" LogicalName="pack/masks/%(RecursiveDir)%(Filename)%(Extension)" />
        <!-- Polices originales du pack (StartupRush Pixel et Mono) -->
        <AvaloniaResource Include="..\assets\StartupRushOriginalAssets\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
