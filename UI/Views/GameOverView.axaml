<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="UI.Views.GameOverView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="440">
        <TextBlock x:Name="TitleText" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SubtitleText" Foreground="#90A4AE" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,16,0,16">
            <TextBlock Grid.Row="0" Text="Statut atteint"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StageText" FontWeight="Bold" Foreground="#FFCA28"/>
            <TextBlock Grid.Row="1" Text="Durée de la partie"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SurvivedText"/>
            <TextBlock Grid.Row="2" Text="Patrimoine record"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PeakText"/>
            <TextBlock Grid.Row="3" Text="Gagné en contrats"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EarnedText"/>
            <TextBlock Grid.Row="4" Text="Contrats livrés"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CompletedText"/>
            <TextBlock Grid.Row="5" Text="Contrats ratés"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="FailedText"/>
        </Grid>

        <Button x:Name="ReplayButton" Content="Rejouer" Classes="accent"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12"/>
        <Button x:Name="MenuButton" Content="Retour au menu"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12"/>
    </StackPanel>
</UserControl>
