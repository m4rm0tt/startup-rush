<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UI.ViewModels"
             xmlns:px="using:UI.Pixel"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="UI.Views.GameOverView">
    <Grid Margin="60,40" ColumnDefinitions="*,40,520" RowDefinitions="Auto,*,Auto">
        <!-- Titre -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="24" Margin="0,0,0,24">
            <Border Classes="inset" Padding="6">
                <px:PixelImage x:Name="PortraitImage" Width="112" Height="112"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <Grid>
                    <TextBlock x:Name="TitleShadow" FontSize="84" FontWeight="Bold" Foreground="#0b0913" Margin="6,6,0,0"/>
                    <TextBlock x:Name="TitleText" FontSize="84" FontWeight="Bold"/>
                </Grid>
                <TextBlock x:Name="SubtitleText" FontSize="22" TextWrapping="Wrap" MaxWidth="1200"/>
            </StackPanel>
        </StackPanel>

        <!-- Gauche : la run en chiffres et sa courbe -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="18">
            <Border Classes="panel" Padding="18">
                <Grid x:Name="StatsGrid" ColumnDefinitions="*,Auto,40,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="FontSize" Value="19"/>
                            <Setter Property="Margin" Value="0,3"/>
                        </Style>
                        <Style Selector="TextBlock.value">
                            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
                            <Setter Property="FontSize" Value="26"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                        </Style>
                    </Grid.Styles>
                    <TextBlock Grid.Row="0" Text="Statut atteint"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StageValue" Classes="value"/>
                    <TextBlock Grid.Row="1" Text="Durée de la run"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TimeValue" Classes="value"/>
                    <TextBlock Grid.Row="2" Text="Patrimoine record"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PeakValue" Classes="value"/>
                    <TextBlock Grid.Row="3" Text="Gagné en contrats"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EarnedValue" Classes="value"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Contrats livrés"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" x:Name="TasksValue" Classes="value"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Crises surmontées"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" x:Name="CrisesValue" Classes="value"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Pression"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" x:Name="PressureValue" Classes="value"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Graine"/>
                    <TextBlock Grid.Row="3" Grid.Column="4" x:Name="SeedValue" Classes="value"/>
                </Grid>
            </Border>

            <Border Classes="panel" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="PATRIMOINE MOIS PAR MOIS" Classes="label"/>
                    <Border Classes="inset" Padding="10">
                        <Canvas x:Name="Chart" Width="840" Height="210"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Droite : atouts et récompenses -->
        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="18">
            <Border Classes="panel" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="ATOUTS DE LA RUN" Classes="label"/>
                    <ItemsControl x:Name="PerksList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PerkCardViewModel">
                                <Border Classes="inset" BorderBrush="{Binding RarityBrush}" Padding="4" Margin="0,0,6,6"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <px:PixelImage Source="{Binding Icon}" Width="40" Height="40"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoPerksText" Text="Aucun atout cette fois." Classes="muted"/>
                </StackPanel>
            </Border>

            <Border Classes="panel" Padding="18" BorderBrush="{StaticResource Gold}">
                <StackPanel Spacing="8">
                    <TextBlock Text="RÉCOMPENSES" Classes="label"/>
                    <StackPanel x:Name="RewardLines" Spacing="2"/>
                    <Rectangle Height="2" Fill="{StaticResource Slate}" Margin="0,6"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <px:PixelImage x:Name="GoldImage" Width="40" Height="40"/>
                        <TextBlock x:Name="LingotsText" Classes="num" FontSize="52" Foreground="{StaticResource Gold}"/>
                        <TextBlock Text="LINGOTS" Classes="label" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="BadgesText" Foreground="{StaticResource Leaf}" FontSize="18" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center"
                    Margin="0,24,0,0">
            <Button x:Name="MenuButton" Content="[ÉCHAP] MENU" Classes="big"/>
            <Button x:Name="ReplayButton" Content="[ENTRÉE] NOUVELLE RUN" Classes="gold big"/>
        </StackPanel>
    </Grid>
</UserControl>
