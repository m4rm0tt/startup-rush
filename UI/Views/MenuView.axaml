<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="UI.Views.MenuView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
        <TextBlock Text="Startup Rush" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="#FFCA28"/>
        <TextBlock Text="De fauché à roi du monde."
                   FontSize="18" HorizontalAlignment="Center"/>
        <TextBlock Foreground="#90A4AE" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Tu commences avec 150 CHF, un portable qui rame et un loyer à payer. Charbonne, prends des contrats, améliore ton matériel, fonde ta boîte, embauche, investis... et deviens milliardaire avant que les factures ne t'enterrent."/>

        <StackPanel Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="Ton prénom"/>
            <TextBox x:Name="PlayerNameBox" PlaceholderText="Alex" MaxLength="20"/>
        </StackPanel>

        <Button x:Name="NewGameButton" Content="Nouvelle partie" Classes="accent"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12"/>
        <Button x:Name="QuitButton" Content="Quitter"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12"/>
    </StackPanel>
</UserControl>
