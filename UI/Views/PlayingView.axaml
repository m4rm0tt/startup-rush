<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UI.ViewModels"
             xmlns:views="using:UI.Views"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
             x:Class="UI.Views.PlayingView"
             x:DataType="vm:PlayingViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#263238"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#90A4AE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.lock">
            <Setter Property="Foreground" Value="#FFA726"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Carte commune au matériel, au logement et aux locaux -->
        <DataTemplate DataType="vm:UpgradeViewModel">
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="muted"/>
                    </Grid>
                    <TextBlock Text="{Binding CurrentName}" Foreground="#FFCA28"/>
                    <TextBlock Text="{Binding NextText}" IsVisible="{Binding !IsMaxed}"/>
                    <TextBlock Text="{Binding EffectText}" Classes="muted"/>
                    <Button Content="{Binding CostText}" Command="{Binding BuyCommand}"
                            IsEnabled="{Binding CanBuy}" IsVisible="{Binding !IsMaxed}"
                            Classes="accent" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <Grid RowDefinitions="Auto,*" Margin="12">
            <!-- Bandeau du haut : histoire, argent, date, factures -->
            <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
                <Grid ColumnDefinitions="340,*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{Binding StageTitle}" FontSize="20" FontWeight="Bold" Foreground="#FFCA28"/>
                        <ProgressBar Value="{Binding StageProgress}" Minimum="0" Maximum="100" Height="6" MinHeight="6"
                                     Foreground="#FFCA28"/>
                        <TextBlock Text="{Binding NextStageText}" Classes="muted"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding BalanceText}" Foreground="{Binding BalanceBrush}"
                                   FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FlashText}" Foreground="#66BB6A"
                                   FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetWorthText}"/>
                            <TextBlock Text="{Binding PassiveText}" Foreground="#66BB6A"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DateText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BillText}" Foreground="{Binding BillBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding MissedText}" Foreground="#EF5350" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="290,12,*,12,380">
                <!-- Demandes des clients -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ReputationText}" FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding ReputationProgress}" Minimum="0" Maximum="100"
                                     Height="5" MinHeight="5" Foreground="#AB47BC"/>
                        <TextBlock Text="{Binding RequestsHeader}" Classes="header" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding AutoAcceptText}" Classes="muted"
                                   IsVisible="{Binding AutoAcceptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RequestViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                           FontWeight="Bold" Foreground="#66BB6A"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding TypeText}" Classes="muted"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DifficultyText}"
                                                           Foreground="#FFCA28" ToolTip.Tip="Difficulté"/>
                                            </Grid>
                                            <TextBlock Text="{Binding WorkText}" Classes="muted"/>
                                            <TextBlock Text="{Binding DeadlineText}" Foreground="{Binding DeadlineBrush}"
                                                       FontSize="12"/>
                                            <ProgressBar Value="{Binding OfferPercent}" Minimum="0" Maximum="100"
                                                         Foreground="{Binding OfferBrush}" Height="3" MinHeight="3"/>
                                            <Grid ColumnDefinitions="*,Auto,6,Auto" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding OfferText}" Foreground="{Binding OfferBrush}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Accepter" Classes="accent"
                                                        Command="{Binding AcceptCommand}"
                                                        IsEnabled="{Binding CanAccept}"/>
                                                <Button Grid.Column="3" Content="Refuser"
                                                        Command="{Binding RejectCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Centre : la scène, les tâches en cours et le journal -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto,150">
                    <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Background="#000000">
                        <Grid>
                            <views:SceneView x:Name="Scene"/>
                            <Border Background="#99000000" CornerRadius="4" Padding="8,3"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Clique sur toi pour charbonner !" Foreground="#FFFFFF" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding CapacityText}" Classes="header"/>
                            <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer MaxHeight="190">
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskViewModel">
                                        <Border Classes="card" Width="220" Margin="0,0,8,8">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                               Foreground="#66BB6A" FontWeight="Bold"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                                             Foreground="{Binding DeadlineBrush}" Height="8" MinHeight="8"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12"/>
                                                <TextBlock Text="{Binding DeadlineText}" Foreground="{Binding DeadlineBrush}"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Grid.Row="2" Classes="card" Margin="0">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogEntry">
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Droite : tout ce qu'on peut acheter -->
                <TabControl Grid.Column="4" Padding="0,6,0,0">
                    <TabItem Header="Matériel">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Equipment}"/>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Maison">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Classes="muted" Margin="0,0,0,8"
                                           Text="Un meilleur logement te repose (plus de vitesse), mais le loyer augmente tes factures."/>
                                <ItemsControl ItemsSource="{Binding Home}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Équipe">
                        <ScrollViewer>
                            <StackPanel>
                                <Border Classes="card">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Ta boîte" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CompanyText}" Foreground="#FFCA28"/>
                                        <StackPanel Spacing="6" IsVisible="{Binding ShowFounding}">
                                            <TextBox Text="{Binding NewCompanyName}" PlaceholderText="Nom de ta boîte"
                                                     MaxLength="30"/>
                                            <Button Content="{Binding FoundText}" Command="{Binding FoundCommand}"
                                                    IsEnabled="{Binding CanFound}" Classes="accent"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StaffText}" Classes="muted"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding HiringLockText}" Classes="lock" IsVisible="{Binding !HiringUnlocked}"/>
                                <ItemsControl ItemsSource="{Binding Office}"/>
                                <ItemsControl ItemsSource="{Binding Employees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EmployeeViewModel">
                                            <Border Classes="card">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Classes="muted"/>
                                                        <TextBlock Text="{Binding CostText}" Classes="muted"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountText}" FontSize="22" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Button Content="−" Command="{Binding FireCommand}"
                                                                    IsEnabled="{Binding CanFire}" ToolTip.Tip="Licencier"/>
                                                            <Button Content="+" Command="{Binding HireCommand}"
                                                                    IsEnabled="{Binding CanHire}" Classes="accent"
                                                                    ToolTip.Tip="Embaucher"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Boîtes">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Text="{Binding BusinessesLockText}" Classes="lock"
                                           IsVisible="{Binding !BusinessesUnlocked}"/>
                                <TextBlock Classes="muted" Margin="0,0,0,8"
                                           Text="Chaque boîte rapporte de l'argent toute seule, chaque seconde. Développe-les pour en gagner plus."/>
                                <Border Classes="card" IsVisible="{Binding HoldingVisible}" BorderBrush="#FFCA28"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Holding" FontWeight="Bold" Foreground="#FFCA28"/>
                                        <TextBlock Text="{Binding HoldingText}" TextWrapping="Wrap"/>
                                        <Button Content="Créer la holding" Command="{Binding BuyHoldingCommand}"
                                                IsEnabled="{Binding CanBuyHolding}" Classes="accent"
                                                HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Businesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BusinessViewModel">
                                            <Border Classes="card">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="muted"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" Classes="muted"/>
                                                    <TextBlock Text="{Binding IncomeText}" Foreground="#66BB6A" FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                                                Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding CostText}" VerticalAlignment="Center"/>
                                                        <Button Content="{Binding ButtonText}" Command="{Binding BuyCommand}"
                                                                IsEnabled="{Binding CanBuy}" Classes="accent"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Bourse">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Text="{Binding MarketLockText}" Classes="lock" IsVisible="{Binding !MarketUnlocked}"/>
                                <TextBlock Text="{Binding PortfolioText}" Classes="header"/>
                                <ItemsControl ItemsSource="{Binding Assets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssetViewModel">
                                            <Border Classes="card">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontWeight="Bold"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Description}" Classes="muted"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ChangeText}"
                                                                   Foreground="{Binding ChangeBrush}" FontSize="12"/>
                                                    </Grid>
                                                    <Polyline Points="{Binding Chart}" Stroke="{Binding ChangeBrush}"
                                                              StrokeThickness="2" Height="46" Margin="0,4"/>
                                                    <TextBlock Text="{Binding HoldingText}" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                        <Button Content="Investir 10 %" Command="{Binding BuyTenPercentCommand}"
                                                                IsEnabled="{Binding CanBuy}"/>
                                                        <Button Content="Investir 50 %" Command="{Binding BuyHalfCommand}"
                                                                IsEnabled="{Binding CanBuy}"/>
                                                        <Button Content="Tout vendre" Command="{Binding SellAllCommand}"
                                                                IsEnabled="{Binding CanSell}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Bandeau d'histoire : s'affiche au début et à chaque nouveau statut -->
        <Border IsVisible="{Binding StoryVisible}" Background="#F01C2529" BorderBrush="#FFCA28" BorderThickness="2"
                CornerRadius="10" Padding="24,18" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding StoryTitle}" FontSize="24" FontWeight="Bold" Foreground="#FFCA28"/>
                <TextBlock Text="{Binding StoryText}" FontSize="15" TextWrapping="Wrap"/>
                <Button Content="C'est parti" Command="{Binding CloseStoryCommand}" Classes="accent"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
