<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UI.ViewModels"
             xmlns:views="using:UI.Views"
             xmlns:px="using:UI.Pixel"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="UI.Views.PlayingView"
             x:DataType="vm:PlayingViewModel">
    <UserControl.Styles>
        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="#d90b0913"/>
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Carte de boutique : matériel, logement, locaux -->
        <DataTemplate DataType="vm:UpgradeViewModel">
            <Border Classes="panel" Width="176" Height="210" Margin="0,0,12,0" Padding="9">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="{Binding CostText}" Command="{Binding BuyCommand}"
                            IsEnabled="{Binding CanBuy}" Classes="gold" HorizontalAlignment="Stretch" FontSize="16"/>
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*">
                            <px:PixelImage Source="{Binding Icon}" Width="36" Height="36"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Classes="h3" FontSize="16"/>
                                <TextBlock Text="{Binding LevelText}" Classes="label" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CurrentName}" Foreground="{StaticResource Gold}" FontSize="14"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NextText}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EffectText}" Classes="muted" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <!-- ======================= LE JEU ======================= -->
        <Grid RowDefinitions="96,*" Margin="16">

            <!-- Bandeau du haut -->
            <Border Grid.Row="0" Classes="panel" Padding="12,8" Margin="0,0,0,14">
                <Grid ColumnDefinitions="470,*,430">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="inset" Padding="2">
                            <px:PixelImage Source="{Binding Portrait}" Width="64" Height="64"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding PlayerName}" FontSize="22" FontWeight="Bold"/>
                                <Border Classes="tag" Background="{StaticResource Gold}">
                                    <TextBlock Text="{Binding StageTitle}" Foreground="{StaticResource Ink}" FontSize="15"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <ProgressBar Value="{Binding StageProgress}" Maximum="100" Width="360" Height="10" MinHeight="10"
                                         Foreground="{StaticResource Gold}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding NextStageText}" Classes="label" FontSize="12" Width="370"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <px:PixelImage Source="{Binding CoinIcon}" Width="36" Height="36" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MoneyText}" Foreground="{Binding MoneyBrush}" Classes="num"
                                       FontSize="56" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FlashText}" Foreground="{StaticResource Leaf}" Classes="num"
                                       FontSize="34" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,-6,0,0">
                            <TextBlock Text="{Binding NetWorthText}" Classes="label"/>
                            <TextBlock Text="{Binding PassiveText}" Foreground="{StaticResource Leaf}" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="4" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <px:PixelImage Source="{Binding CalendarIcon}" Width="24" Height="24"/>
                                <TextBlock Text="{Binding DateText}" Classes="num" FontSize="30" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        ToolTip.Tip="{Binding BillDetail}">
                                <px:PixelImage Source="{Binding BillIcon}" Width="20" Height="20"/>
                                <TextBlock Text="{Binding BillAmountText}" Foreground="{Binding BillBrush}" Classes="num"
                                           FontSize="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BillTimeText}" Classes="label" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding MonthProgress}" Maximum="100" Width="250" Height="6" MinHeight="6"
                                         Foreground="{Binding BillBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShieldVisible}"
                                        ToolTip.Tip="Factures impayées pardonnées par ton assurance">
                                <px:PixelImage Source="{Binding ShieldIcon}" Width="24" Height="24"/>
                                <TextBlock Text="{Binding ShieldText}" Classes="num" FontSize="22"/>
                            </StackPanel>
                            <px:PixelImage Source="{Binding WarningIcon}" Width="30" Height="30"
                                           IsVisible="{Binding MissedVisible}"
                                           ToolTip.Tip="Facture impayée ! Encore une et c'est la faillite."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="300,14,*,14,300">

                <!-- Contrats -->
                <Border Grid.Column="0" Classes="panel" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RequestsHeader}" Classes="h3"/>
                            <TextBlock Text="{Binding ReputationText}" Classes="label" FontSize="12"/>
                            <ProgressBar Value="{Binding ReputationProgress}" Maximum="100" Height="6" MinHeight="6"
                                         Foreground="{StaticResource Plum}"/>
                            <TextBlock Text="{Binding AutoAcceptText}" Classes="muted" FontSize="13"
                                       IsVisible="{Binding AutoAcceptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Requests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RequestViewModel">
                                        <Border Classes="inset" Margin="0,0,0,8" Padding="8">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ClientName}" FontSize="15" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Classes="num"
                                                               FontSize="22" Foreground="{StaticResource Gold}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding TypeText}" Classes="label" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DifficultyText}" FontSize="12"
                                                               Foreground="{StaticResource Lemon}" ToolTip.Tip="Difficulté"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WorkText}" Classes="label" FontSize="13"/>
                                                <TextBlock Text="{Binding DeadlineText}" Foreground="{Binding DeadlineBrush}"
                                                           FontSize="13" TextWrapping="Wrap"/>
                                                <ProgressBar Value="{Binding OfferPercent}" Maximum="100" Height="4"
                                                             MinHeight="4" Foreground="{Binding OfferBrush}" Margin="0,2"/>
                                                <Grid ColumnDefinitions="*,6,Auto">
                                                    <Button Content="ACCEPTER" Command="{Binding AcceptCommand}"
                                                            IsEnabled="{Binding CanAccept}" Classes="green"
                                                            HorizontalAlignment="Stretch" FontSize="15" Padding="6,4"/>
                                                    <Button Grid.Column="2" Content="X" Command="{Binding RejectCommand}"
                                                            Classes="red" FontSize="15" Padding="10,4"
                                                            ToolTip.Tip="Refuser"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Centre : la scène et la boutique -->
                <Grid Grid.Column="2" RowDefinitions="460,12,*">
                    <Border Grid.Row="0" Classes="panel" Padding="0" Background="#0b0913">
                        <Grid>
                            <views:SceneView x:Name="Scene"/>
                            <Border IsVisible="{Binding CrisisVisible}" Background="{Binding CrisisBrush}"
                                    VerticalAlignment="Top" Padding="10,4" IsHitTestVisible="False">
                                <TextBlock Text="{Binding CrisisText}" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Background="#b3181425" Padding="10,3" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center" Margin="0,0,0,8" IsHitTestVisible="False">
                                <TextBlock Text="CLIQUE OU [ESPACE] POUR CHARBONNER" FontSize="13"
                                           Foreground="{StaticResource Cloud}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                            <Button Content="MATÉRIEL" Command="{Binding ShowEquipmentCommand}"
                                    Classes="tab" Classes.selected="{Binding IsEquipmentTab}"/>
                            <Button Content="MAISON" Command="{Binding ShowHomeCommand}"
                                    Classes="tab" Classes.selected="{Binding IsHomeTab}"/>
                            <Button Content="ÉQUIPE" Command="{Binding ShowTeamCommand}"
                                    Classes="tab" Classes.selected="{Binding IsTeamTab}"/>
                            <Button Content="EMPIRE" Command="{Binding ShowEmpireCommand}"
                                    Classes="tab" Classes.selected="{Binding IsEmpireTab}"/>
                            <Button Content="BOURSE" Command="{Binding ShowMarketCommand}"
                                    Classes="tab" Classes.selected="{Binding IsMarketTab}"/>
                        </StackPanel>

                        <Grid>
                            <!-- Matériel -->
                            <ScrollViewer IsVisible="{Binding IsEquipmentTab}" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Equipment}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Maison -->
                            <StackPanel IsVisible="{Binding IsHomeTab}" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Home}"/>
                                <TextBlock Classes="muted" Width="420" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="Un meilleur logement te repose : tu travailles plus vite. Mais le loyer alourdit chaque facture, et la vue change par la fenêtre."/>
                            </StackPanel>

                            <!-- Équipe -->
                            <ScrollViewer IsVisible="{Binding IsTeamTab}" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Classes="panel" Width="230" Height="210" Padding="9">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="TA BOÎTE" Classes="label"/>
                                            <TextBlock Text="{Binding CompanyText}" Foreground="{StaticResource Gold}"
                                                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <StackPanel Spacing="6" IsVisible="{Binding ShowFounding}">
                                                <TextBox Text="{Binding NewCompanyName}" PlaceholderText="Nom de ta boîte"
                                                         MaxLength="24" FontSize="15"/>
                                                <Button Content="{Binding FoundText}" Command="{Binding FoundCommand}"
                                                        IsEnabled="{Binding CanFound}" Classes="gold"
                                                        HorizontalAlignment="Stretch" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StaffText}" Classes="muted" FontSize="13"/>
                                            <TextBlock Text="{Binding HiringLockText}" Foreground="{StaticResource Ember}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       IsVisible="{Binding !HiringUnlocked}"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Office}"/>
                                    <ItemsControl ItemsSource="{Binding Employees}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EmployeeViewModel">
                                                <Border Classes="panel" Width="200" Height="210" Margin="0,0,12,0" Padding="9">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto">
                                                            <Button Content="−" Command="{Binding FireCommand}"
                                                                    IsEnabled="{Binding CanFire}" Classes="red"
                                                                    ToolTip.Tip="Licencier"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="num"
                                                                       FontSize="30" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Content="+" Command="{Binding HireCommand}"
                                                                    IsEnabled="{Binding CanHire}" Classes="gold"
                                                                    ToolTip.Tip="Embaucher"/>
                                                        </Grid>
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <px:PixelImage Source="{Binding Icon}" Width="30" Height="30"/>
                                                                <TextBlock Text="{Binding Title}" Classes="h3" FontSize="16"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13"/>
                                                            <TextBlock Text="{Binding CostText}" Classes="label" FontSize="12"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Empire : boîtes et holding -->
                            <Grid IsVisible="{Binding IsEmpireTab}">
                                <StackPanel IsVisible="{Binding !BusinessesUnlocked}" Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <px:PixelImage Source="{Binding LockIcon}" Width="48" Height="48"/>
                                    <TextBlock Text="{Binding BusinessesLockText}" Classes="h3" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ScrollViewer IsVisible="{Binding BusinessesUnlocked}" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Classes="panel" Width="220" Height="210" Margin="0,0,12,0" Padding="9"
                                                BorderBrush="{StaticResource Gold}" IsVisible="{Binding HoldingVisible}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Bottom" Content="CRÉER LA HOLDING"
                                                        Command="{Binding BuyHoldingCommand}" IsEnabled="{Binding CanBuyHolding}"
                                                        Classes="gold" HorizontalAlignment="Stretch" FontSize="15"/>
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <px:PixelImage Source="{Binding CrownIcon}" Width="36" Height="36"/>
                                                        <TextBlock Text="HOLDING" Classes="h3"
                                                                   Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding HoldingText}" Classes="muted" FontSize="14"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Businesses}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BusinessViewModel">
                                                    <Border Classes="panel" Width="210" Height="210" Margin="0,0,12,0" Padding="9">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                                                                <TextBlock Text="{Binding CostText}" Classes="num" FontSize="20"
                                                                           Foreground="{StaticResource Gold}"/>
                                                                <Button Content="{Binding ButtonText}" Command="{Binding BuyCommand}"
                                                                        IsEnabled="{Binding CanBuy}" Classes="gold" FontSize="13"
                                                                        HorizontalAlignment="Stretch"/>
                                                            </StackPanel>
                                                            <StackPanel Spacing="3">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <px:PixelImage Source="{Binding Icon}" Width="32" Height="32"/>
                                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                                                   FontWeight="Bold" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding LevelText}" Classes="label"
                                                                                   FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12"/>
                                                                <TextBlock Text="{Binding IncomeText}" Foreground="{StaticResource Leaf}"
                                                                           FontSize="12" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Bourse -->
                            <Grid IsVisible="{Binding IsMarketTab}">
                                <StackPanel IsVisible="{Binding !MarketUnlocked}" Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <px:PixelImage Source="{Binding LockIcon}" Width="48" Height="48"/>
                                    <TextBlock Text="{Binding MarketLockText}" Classes="h3" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DockPanel IsVisible="{Binding MarketUnlocked}">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding PortfolioText}" Classes="label" Margin="0,0,0,4"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Assets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AssetViewModel">
                                                    <Border Classes="panel" Width="210" Height="190" Margin="0,0,12,0" Padding="9">
                                                        <StackPanel Spacing="2">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ChangeText}"
                                                                           Foreground="{Binding ChangeBrush}" Classes="num"
                                                                           FontSize="18"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding PriceText}" Classes="num" FontSize="20"/>
                                                            <Border Classes="inset" Padding="4">
                                                                <Polyline Points="{Binding Chart}" Stroke="{Binding ChangeBrush}"
                                                                          StrokeThickness="2" Height="40" Width="180"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding HoldingText}" Classes="label" FontSize="12"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Content="10%" Command="{Binding BuyTenPercentCommand}"
                                                                        IsEnabled="{Binding CanBuy}" FontSize="13" Padding="6,2"/>
                                                                <Button Content="50%" Command="{Binding BuyHalfCommand}"
                                                                        IsEnabled="{Binding CanBuy}" FontSize="13" Padding="6,2"/>
                                                                <Button Content="VENDRE" Command="{Binding SellAllCommand}"
                                                                        IsEnabled="{Binding CanSell}" Classes="red" FontSize="13"
                                                                        Padding="6,2"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- Colonne de droite : travail en cours, atouts, effets, journal -->
                <Border Grid.Column="4" Classes="panel" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding CapacityText}" Classes="h3"/>
                            </Grid>
                            <TextBlock Text="{Binding SpeedText}" Classes="label" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding Tasks}" MaxHeight="230" ClipToBounds="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskViewModel">
                                        <Border Classes="inset" Margin="0,4,0,0" Padding="6">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ClientName}" FontSize="13" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Classes="num"
                                                               FontSize="18" Foreground="{StaticResource Gold}"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8"
                                                             MinHeight="8" Foreground="{Binding DeadlineBrush}"/>
                                                <TextBlock Text="{Binding DeadlineText}" Foreground="{Binding DeadlineBrush}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding PerksHeader}" Classes="h3" Margin="0,12,0,0"/>
                            <ItemsControl ItemsSource="{Binding Perks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PerkCardViewModel">
                                        <Border Classes="inset" BorderBrush="{Binding RarityBrush}" Padding="4"
                                                Margin="0,4,4,0" ToolTip.Tip="{Binding Tooltip}">
                                            <px:PixelImage Source="{Binding Icon}" Width="30" Height="30"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Effects}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EffectViewModel">
                                        <Border Background="{StaticResource Ink}" BorderBrush="{Binding Brush}"
                                                BorderThickness="2,0,0,0" Padding="6,3" Margin="0,0,0,4"
                                                ToolTip.Tip="{Binding Description}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding MonthsText}" Classes="label"
                                                           FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="JOURNAL" Classes="h3" Margin="0,8,0,4"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Log}" ClipToBounds="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogEntry">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" Classes="num"
                                               FontSize="18" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= INTRO DE LA RUN ======================= -->
        <Border Classes="overlay" IsVisible="{Binding IntroVisible}">
            <Border Classes="panel" Width="780" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Gold}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <Border Classes="inset" Padding="4">
                            <px:PixelImage Source="{Binding Portrait}" Width="128" Height="128"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="8" Width="560">
                            <TextBlock Text="{Binding IntroTitle}" Classes="h2" Foreground="{StaticResource Gold}"
                                       TextWrapping="Wrap"/>
                            <Border Classes="tag">
                                <TextBlock Text="{Binding IntroTrait}" FontSize="15" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding RunInfo}" Classes="label"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding IntroText}" FontSize="18" TextWrapping="Wrap" LineHeight="26"/>
                    <TextBlock Classes="muted" FontSize="15"
                               Text="Paie tes factures chaque mois. Deux impayés d'affilée, et c'est la fin de la run. Un mois sur trois, une crise frappe."/>
                    <Button Content="[ENTRÉE]  AU BOULOT !" Command="{Binding StartCommand}" Classes="gold big"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================= CHOIX D'ATOUT ======================= -->
        <Border Classes="overlay" IsVisible="{Binding DraftVisible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Width="1200"
                        DataContext="{Binding Draft}" x:DataType="vm:DraftViewModel">
                <TextBlock Text="{Binding Title}" Classes="h1" Foreground="{StaticResource Gold}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="19" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" MaxWidth="900"/>
                <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Center" Margin="0,16,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="26"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PerkCardViewModel">
                            <Button Command="{Binding ChooseCommand}" Padding="0" Background="Transparent"
                                    BorderThickness="0">
                                <Border Classes="panel lift" Width="250" Height="340" BorderBrush="{Binding RarityBrush}"
                                        BorderThickness="4" Padding="16">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding KeyHint}" Classes="key"
                                                   HorizontalAlignment="Center"/>
                                        <StackPanel Spacing="10">
                                            <Border Classes="tag" Background="{Binding RarityBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding RarityText}" Foreground="{StaticResource Ink}"
                                                           FontSize="14" FontWeight="Bold"/>
                                            </Border>
                                            <Border Classes="inset" HorizontalAlignment="Center" Padding="10">
                                                <px:PixelImage Source="{Binding Icon}" Width="96" Height="96"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="17" TextAlignment="Center"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Cloud}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button Content="{Binding RerollText}" Command="{Binding RerollCommand}" IsEnabled="{Binding CanReroll}"
                            ToolTip.Tip="[R] Tirer trois nouvelles cartes"/>
                    <Button Content="{Binding SkipText}" Command="{Binding SkipCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= ÉVÉNEMENT ======================= -->
        <Border Classes="overlay" IsVisible="{Binding EventVisible}">
            <Border Classes="panel" Width="760" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Ice}" DataContext="{Binding Event}" x:DataType="vm:EventViewModel">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Classes="inset" Padding="8">
                            <px:PixelImage Source="{Binding Icon}" Width="72" Height="72"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" Classes="h2" Foreground="{StaticResource Ice}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Width="580"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="19" TextWrapping="Wrap" LineHeight="27"/>

                    <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding !IsResolved}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventOptionViewModel">
                                <Button Command="{Binding ChooseCommand}" IsEnabled="{Binding IsEnabled}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8" Padding="14,8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding KeyHint}" Classes="key" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="14" Foreground="{StaticResource Fog}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="14" IsVisible="{Binding IsResolved}">
                        <Border Classes="inset" Padding="14">
                            <TextBlock Text="{Binding Outcome}" FontSize="19" TextWrapping="Wrap"
                                       Foreground="{StaticResource Lemon}"/>
                        </Border>
                        <Button Content="[ENTRÉE]  CONTINUER" Command="{Binding ContinueCommand}" Classes="gold"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================= PAUSE ======================= -->
        <Border Classes="overlay" IsVisible="{Binding PauseVisible}">
            <Border Classes="panel" Width="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="PAUSE" Classes="h1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RunInfo}" Classes="label" HorizontalAlignment="Center"/>
                    <Button Content="[ÉCHAP]  REPRENDRE" Command="{Binding ResumeCommand}" Classes="gold big"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding MusicText}" Command="{Binding ToggleMusicCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding SoundText}" Command="{Binding ToggleSoundCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="ABANDONNER LA RUN" Command="{Binding AbandonCommand}" Classes="red"
                            HorizontalAlignment="Stretch"/>
                    <Border Classes="inset" Margin="0,8,0,0">
                        <TextBlock Classes="key" TextWrapping="Wrap"
                                   Text="ESPACE charbonner · 1-4 choisir · R relancer · ENTRÉE continuer · ÉCHAP pause · F11 plein écran"/>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
